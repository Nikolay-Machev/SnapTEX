{
  "name": "snaptex",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build && tsc -p tsconfig.server.json",
    "dev": "tsx server.ts --dev",
    "start": "node build/transport/server.js",
    "model:serve": "cd ml && uvicorn snaptex_ml.app:app --host 127.0.0.1 --port 8000",
    "model:test": "cd ml && .venv/bin/python -m pytest",
    "test": "vitest run",
    "typecheck": "react-router typegen && tsc",
    "format": "prettier --write server.ts server app tests/*.ts tests/*.tsx tsconfig.server.json",
    "format:check": "prettier --check server.ts server app tests/*.ts tests/*.tsx tsconfig.server.json",
    "eval": "cd ml && python evaluate.py",
    "eval:gate": "cd ml && python evaluate.py --model http://127.0.0.1:3000/api/convert --max-cer 0.80 --max-errors 0",
    "eval:crops": "cd ml && python evaluate.py --model http://127.0.0.1:3000/api/convert --manifest ../tests/fixtures/equations/difficult-equations.json --crop-mode both"
  },
  "dependencies": {
    "@react-router/express": "^8.3.1",
    "@react-router/node": "^8.3.1",
    "@react-router/serve": "^8.3.1",
    "busboy": "^1.6.0",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "ipaddr.js": "^2.5.0",
    "isbot": "^5.1.36",
    "katex": "^0.16.22",
    "openai": "^7.9.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@react-router/dev": "^8.3.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/busboy": "^1.5.5",
    "@types/express": "^5.0.6",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.19.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
