# Safe local default: no external API calls are made.
RECOGNITION_PROVIDER=mock

# Use `local` for the public baseline. Do not use the failed v0.1 experiment
# (108.57% validation CER) for the beta.
# Both call the same model-neutral Python service.
# RECOGNITION_PROVIDER=local

# Used when RECOGNITION_PROVIDER=local or snaptex.
LOCAL_RECOGNITION_URL=http://127.0.0.1:8000

# Used by the Python model service. This is the beta baseline and the default:
SNAPTEX_MODEL_ID=tjoab/latex_finetuned
# SNAPTEX_DEVICE=auto

# Local inference protection. A T4 can normally begin with concurrency 2;
# tune this only after measuring memory use and latency.
SNAPTEX_MAX_CONCURRENCY=2
SNAPTEX_QUEUE_TIMEOUT_SECONDS=2
SNAPTEX_INFERENCE_TIMEOUT_SECONDS=120
SNAPTEX_RATE_LIMIT_REQUESTS=30
SNAPTEX_RATE_LIMIT_WINDOW_SECONDS=60
# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For.
SNAPTEX_TRUST_PROXY=false
SNAPTEX_LOG_LEVEL=INFO

# Required only when RECOGNITION_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-sol
