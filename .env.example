# Safe local default: no external API calls are made.
RECOGNITION_PROVIDER=mock

# Use `local` for the public baseline or `snaptex` for your fine-tuned model.
# Both call the same model-neutral Python service.
# RECOGNITION_PROVIDER=snaptex

# Used when RECOGNITION_PROVIDER=local or snaptex.
LOCAL_RECOGNITION_URL=http://127.0.0.1:8000

# Used by the Python model service. For Docker, point this at the mounted
# fine-tuned checkpoint after training:
# SNAPTEX_MODEL_ID=/models/checkpoints/snaptex-trocr-v0.1
# When running uvicorn directly from ml/, use:
# SNAPTEX_MODEL_ID=checkpoints/snaptex-trocr-v0.1
# SNAPTEX_DEVICE=auto

# Required only when RECOGNITION_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-sol
